# Production environment template.
#
# This is a TEMPLATE with placeholder values only - never put real secrets in
# this file (it's committed to git). To actually deploy, either:
#   - copy this to a local file (e.g. prod.env), fill in real values, and
#     upload it as the "mc-backend-env" Jenkins secret-file credential
#     (see Jenkinsfile) - the normal production path, or
#   - copy it to backend/.env and fill in real values, if you're pointing a
#     local dev server at a real environment for manual testing. backend/.env
#     is gitignored, so real secrets there stay local.
#
# Compare with .env.example (the dev template - local Postgres, dummy JWT
# secret) to see exactly what differs for production.

DATABASE_URL=postgresql+asyncpg://<db_user>:<db_password>@<db_host>:5432/onlinedb
DB_SCHEMA=metag

# Generate with: openssl rand -hex 32
JWT_SECRET=<generate-a-fresh-random-value-do-not-reuse-the-dev-default>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

UPLOAD_DIR=./uploads

# Set to true to allow the RAG engine to fall back on general model knowledge
# instead of "insufficient information" when no approved document matches.
ALLOW_EXTERNAL_KNOWLEDGE=false

EMBEDDING_DIM=384

# DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=INFO
